# Yjeek Admin Portal — environment example
# Copy to `.env` for local development. Change only VITE_API_BASE_URL for production.

# Backend API base (include /api/v1). No trailing slash required.
# Local dev (AWS RDS backend on this machine):
VITE_API_BASE_URL=http://localhost:3000/api/v1
# Remote dev / production:
# VITE_API_BASE_URL=http://192.168.10.251:3000/api/v1
# VITE_API_BASE_URL=https://api.yjeektech.com/api/v1

# Admin Panel mocks.
# true  = use mock client for Admin screens that are not feature-flagged real
# false = no Admin mocks; missing/unwired data stays empty (or hits real API)
VITE_ADMIN_USE_MOCK_API=true

# Feature-scoped Admin real APIs (comma-separated).
# Leave empty to keep Admin fully on mocks when VITE_ADMIN_USE_MOCK_API=true.
# Enable confirmed features only, e.g.:
#   VITE_ADMIN_REAL_API_FEATURES=auth,dashboard,vendors,users,fleet,reports,sla-models
# Listed features always hit the real backend (never padded with mock shell data).
VITE_ADMIN_REAL_API_FEATURES=

# Google Maps JavaScript API (browser key for Coverage map).
# Restrict by HTTP referrer in Google Cloud Console. Restart dev server after change.
VITE_GOOGLE_MAPS_API_KEY=

# Optional public media/CDN origin (defaults to API host without /api/v1).
# VITE_MEDIA_BASE_URL=https://api.yjeektech.com
VITE_API_TIMEOUT_MS=30000

# Do not put passwords, access tokens, or refresh tokens in Vite env files.
# Maps browser keys are public by design — always restrict by HTTP referrer.
